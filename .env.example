# Laya Ops — copy to .env and fill in. Never commit the real .env.

# ---- app ---------------------------------------------------------------------
PORT=9190
APP_NAME=Laya Ops
# Dev only (reload): uvicorn app.main:app --reload --port 8000

# ---- plane identity (shown in the UI + used by SSH helper commands) ---------
PLANE_NAME=VM105
PLANE_SITE=hq1
PLANE_HOST=10.10.0.107
PLANE_SSH_USER=root

# ---- auth: off | password | oidc --------------------------------------------
AUTH_MODE=password
APP_PASSWORD=change-me-operator-password
# openssl rand -hex 32
SESSION_SECRET=replace-with-32-byte-random-hex
# set true when the app is served over HTTPS (reverse proxy / CF Access)
COOKIE_SECURE=false

# OIDC (Keycloak) — required when AUTH_MODE=oidc
# OIDC_ISSUER=https://sso.smkn12jakarta.sch.id/realms/school
# OIDC_CLIENT_ID=laya-ops
# OIDC_CLIENT_SECRET=replace-me
# OIDC_REDIRECT_URI=https://laya.smkn12jakarta.sch.id/api/auth/oidc/callback

# ---- upstreams (backend runs on VM105, so localhost is correct) ---------------
HEALER_BASE=http://127.0.0.1:9181
PROMETHEUS_BASE=http://127.0.0.1:9090
ALERTMANAGER_BASE=http://127.0.0.1:9093
GRAFANA_BASE=http://127.0.0.1:3000
GRAFANA_PUBLIC_URL=https://grafana.smkn12jakarta.sch.id

# ---- optional runtimes (leave empty when not deployed) -----------------------
# Laya classifier — /healthz is probed for the model name shown in Endpoints.
# CLASSIFIER_BASE=http://127.0.0.1:8090
# sre-healer k8s engine — /healthz + /decisions shown on the Healer page.
# ENGINE_HEALER_BASE=http://127.0.0.1:8080

# ---- hardening ---------------------------------------------------------------
# comma separated Host headers accepted by TrustedHostMiddleware (empty = allow all)
ALLOWED_HOSTS=laya.hq1.lan,10.10.0.107,localhost
# exact browser origins for unsafe requests (scheme + host + port, comma separated).
# REQUIRED when GOALS_ENABLED=true. The reverse-proxy public origin must match.
# Leave empty for local development; set the URL you actually open in production.
# PUBLIC_ORIGIN=https://laya.example.lan
CACHE_TTL=4
UPSTREAM_TIMEOUT=6
MAX_REQUEST_BODY=65536

# ---- AI goals (every switch defaults off) ------------------------------------
# Turning this on requires AUTH_MODE != off, a random SESSION_SECRET and
# PUBLIC_ORIGIN set.
GOALS_ENABLED=false
# GOALS_DATA_DIR=/app/data
# Opt-in execution: Ops signs approved plans and sends them to the healer
# loopback control API. Keep false until the healer side is deployed and the
# dry-run rehearsal is done. The k8s.deployment.rollback.v1 template additionally
# needs K8S_ALLOW on the healer (empty K8S_ALLOW = k8s goals disabled).
GOALS_EXECUTE_ENABLED=false
GOALS_AUTO_EXECUTE_AFTER_APPROVAL=false

# Who may approve. Use OIDC groups/names for two-person approval; password mode
# has a single identity and must be explicitly opted into.
GOALS_APPROVERS=
GOALS_APPROVER_GROUPS=
GOALS_ALLOW_SELF_APPROVAL=false
GOALS_ALLOW_PASSWORD_APPROVAL=false
# Optional. If set, high-risk actions require this passphrase at approval time.
# GOALS_HIGH_RISK_PASSPHRASE=
GOALS_PREVIEW_TTL=300
GOALS_APPROVAL_TTL=900
GOALS_EXECUTION_TTL=600
GOALS_MAX_GOAL_CHARS=1000
GOALS_RATE_LIMIT_PER_HOUR=10

# Optional LLM planner. Rules are always the validator; this key never reaches
# the browser, plan, audit log or LLM prompt. The k8s.deployment.rollback.v1
# template is rules-only and never calls the LLM.
GOALS_LLM_ENABLED=false
# GOALS_LLM_URL=
# GOALS_LLM_KEY=
# GOALS_LLM_MODEL=

# Execution dispatch target. Must be loopback; the key (32+ chars) must match
# CONTROL_KEY on the healer. Ops refuses to start otherwise.
GOALS_CONTROL_BASE=http://127.0.0.1:9182
# GOALS_CONTROL_KEY=
# Total wall-clock budget to follow one run before marking it unknown.
GOALS_CONTROL_TIMEOUT=150
# Per-request timeout; must be shorter than GOALS_CONTROL_TIMEOUT.
GOALS_CONTROL_REQUEST_TIMEOUT=15
# Journal poll interval while dispatching/executing (minimum 0.5).
GOALS_CONTROL_POLL_INTERVAL=2
